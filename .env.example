# Google Sheet that stores everything (the long id in its URL)
EL_SHEET_ID=1RVnf5OMJ__-zoiNxjUv793i7Q0l22o9t5XdDf9smTUQ

# Paste the WHOLE service-account key JSON (one line), or base64 of it. The Sheet must be shared (Editor) with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Signs the PIN session cookie (required in production). Generate: openssl rand -hex 32
APP_SECRET=

# Optional: time zone used for "today" (default Asia/Kolkata)
# APP_TZ=Asia/Kolkata

# AI features use the command-line AI tool installed and logged in on the machine running the server or the bridge.
# Optional: full path to it if it is not on PATH.
# EL_AI_BIN=
# Optional (browser): where the deployed site looks for the local bridge.
# NEXT_PUBLIC_AI_BRIDGE_URL=http://127.0.0.1:8787
